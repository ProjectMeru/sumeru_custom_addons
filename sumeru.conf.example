# Copy to sumeru.conf (keep in this directory). Paths are relative to this file unless absolute.
# Run from sumeru repo: go run ./cmd/sumeru -- -c ../sumeru_custom_addons/sumeru.conf

[options]

# Database (required)
db_host = localhost
db_port = 5432
db_user = postgres
db_password = postgres
db_name = sumeru
db_sslmode = disable

# HTTP (required)
http_port = 8080
# http_interface = 127.0.0.1
dev_mode = true

# Setup wizard — first run only; leave setup_token empty to skip
setup_localhost_only = true
setup_token =

# Core platform tree (go.mod module sumeru); assets/templates resolve here
sumeru_home = ../sumeru

# Addons (required) — core apps, standard business addons, then this repo’s addons/
addons_path = ../sumeru/addons,../sumeru_addons,./addons

# Logging — enable stdout and/or log_file (at least one sink)
log_enabled = true
log_stdout = true
log_timezone = Local
log_rolling = false

# File logging (optional; uncomment for local log files)
# log_file = ./logs/sumeru.log
# log_rolling = true
# log_max_size_mb = 100
# log_max_backups = 10
# log_max_age_days = 30

# Branding / paths (optional)
# assets_path =
# templates_path =
# brand_css =
# logo_path =
# company_display_name =
# user_display_name =
