# Copy to sumeru.conf and tune. Paths are relative to this file’s directory unless absolute.
# See ../sumeru/sumeru.conf for the full variable list.

[options]
db_host = localhost
db_port = 5432
db_user = postgres
db_password = postgres
db_name = sumeru
db_sslmode = disable

http_port = 8080

# Standard tree (go.mod module sumeru); core/base and default assets/templates resolve here.
sumeru_home = ../sumeru

# Extra installable apps: standard addons, then this repo’s addons/.
addons_path = ../sumeru/addons,./addons

# Optional: append application log (parent dirs created); still mirrored to stderr.
# log_file = ./logs/sumeru.log
