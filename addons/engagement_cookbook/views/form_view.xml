<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_engagement_project_form" model="engagement.project" type="form">
            <header>
                <button name="action_confirm" string="Activate" type="object" class="sum_highlight" />
                <button name="action_done" string="Done" type="object" />
                <button name="action_reset_draft" string="Reset to Draft" type="object" />
                <field name="state" widget="statusbar" options="clickable:1" />
            </header>
            <sheet>
                <div class="sum_title">
                    <field name="avatar" widget="image" />
                    <h1>
                        <field name="name" widget="char" placeholder="Title..." />
                    </h1>
                </div>
                <group>
                    <group string="Identity">
                        <field name="reference" widget="default" />
                        <field name="external_code" />
                        <field name="serial_number" />
                        <field name="short_code" />
                        <field name="public_id" readonly="1" />
                        <field name="priority" widget="priority" options="mode:stars,stars:5" />
                        <field name="kind" widget="radio" />
                        <field name="color_code" widget="color" />
                    </group>
                    <group string="Flags">
                        <field name="active" widget="radio" />
                        <field name="verified" widget="boolean" />
                        <field name="archived" widget="boolean_toggle" />
                        <field name="sequence" />
                    </group>
                </group>
                <notebook>
                    <page string="Overview" name="overview">
                        <group>
                            <group string="Numbers">
                                <field name="quantity" widget="integer" />
                                <field name="progress_pct" widget="progress" />
                                <field name="rating" widget="integer" />
                                <field name="amount" widget="float" />
                                <field name="price" widget="numeric" />
                                <field name="tax_rate" />
                                <field name="balance" />
                            </group>
                            <group string="Money">
                                <field name="currency_id" widget="selection" />
                                <field name="subtotal" widget="monetary" />
                                <field name="tax_amount" widget="monetary" />
                                <field name="salary" widget="monetary" />
                            </group>
                        </group>
                        <group>
                            <group string="Dates">
                                <field name="date_start" widget="date" />
                                <field name="date_stop" widget="date" />
                                <field name="datetime_due" widget="datetime" />
                                <field name="completed_at" widget="datetime" />
                                <field name="opening_time" />
                                <field name="closing_time" />
                                <field name="processing_time" />
                            </group>
                            <group string="Contact">
                                <field name="email" widget="email" />
                                <field name="phone" widget="phone" />
                                <field name="website" widget="url" />
                            </group>
                        </group>
                    </page>
                    <page string="Text and media" name="text_media">
                        <field name="description" widget="text" />
                        <field name="notes" widget="html" />
                        <field name="document" widget="binary" />
                        <field name="settings" widget="json" />
                        <field name="metadata_json" widget="json" />
                    </page>
                    <page string="Team and client" name="relations">
                        <group>
                            <group string="Company">
                                <field name="company_id" widget="selection" />
                                <field name="company_name" readonly="1" />
                                <field name="user_id" widget="many2one" />
                                <field name="employee_id" widget="many2one" />
                                <field name="partner_id" widget="many2one" />
                            </group>
                            <group string="Geo">
                                <field name="country_id" widget="selection" />
                                <field name="state_id" widget="selection" />
                                <field name="city_id" widget="selection" />
                            </group>
                        </group>
                        <group string="Hierarchy">
                            <field name="parent_id" widget="many2one" />
                        </group>
                        <field name="tag_ids" widget="many2many_tags" />
                        <field name="service_line_ids" widget="many2many" />
                    </page>
                    <page string="Reference" name="reference">
                        <field name="resource_ref" widget="reference" />
                        <field name="resource_model" />
                        <field name="resource_id" />
                    </page>
                    <page string="Computed" name="computed">
                        <field name="computed_amount" readonly="1" />
                        <field name="stored_line_count" readonly="1" />
                    </page>
                    <page string="Deliverables" name="lines">
                        <field name="deliverable_ids" widget="one2many">
                            <list editable="bottom">
                                <field name="name" />
                                <field name="quantity" />
                                <field name="unit_price" />
                                <field name="line_total" readonly="1" />
                                <field name="note" />
                            </list>
                        </field>
                    </page>
                    <page string="Sub-engagements" name="children">
                        <field name="child_ids">
                            <list>
                                <field name="name" />
                                <field name="state" />
                                <field name="date_start" />
                            </list>
                        </field>
                    </page>
                    <page string="Milestones" name="milestones">
                        <field name="milestone_ids">
                            <list>
                                <field name="name" />
                                <field name="date_start" />
                                <field name="state" />
                            </list>
                        </field>
                    </page>
                    <page string="Client sites" name="sites">
                        <field name="site_ids">
                            <list>
                                <field name="name" />
                                <field name="latitude" />
                                <field name="longitude" />
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <footer>
                <button name="action_confirm" string="Activate" type="object" />
            </footer>
            <chatter />
        </view>
    </data>
</sumeru>
