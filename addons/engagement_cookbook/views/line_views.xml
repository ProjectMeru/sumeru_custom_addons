<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_engagement_deliverable_list" model="engagement.deliverable" type="list">
            <report download="csv,xlsx,pdf" upload="bulk" pdf_sizes="a4,letter" modes="create,upsert"/>
            <field name="sequence" widget="handle" />
            <field name="project_id" />
            <field name="name" />
            <field name="quantity" />
            <field name="unit_price" />
            <field name="line_total" />
        </view>
        <view id="view_engagement_deliverable_form" model="engagement.deliverable" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="Deliverable description..." />
                    </h1>
                </div>
                <group>
                    <field name="project_id" widget="many2one" />
                    <field name="sequence" />
                    <field name="quantity" />
                    <field name="unit_price" />
                    <field name="line_total" readonly="1" />
                    <field name="note" widget="text" required="quantity > 1" />
                </group>
            </sheet>
        </view>
        <view id="view_engagement_deliverable_search" model="engagement.deliverable" type="search">
            <field name="name" />
            <field name="project_id" />
        </view>
    </data>
</sumeru>
