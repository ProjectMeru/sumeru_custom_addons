<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <record id="module_category_engagement_cookbook" model="sys.module.category">
            <field name="name">Engagements Cookbook</field>
            <field name="sequence">100</field>
        </record>

        <record id="group_engagement_cookbook_user" model="core.group">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_engagement_cookbook"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_engagement_cookbook_manager" model="core.group">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_engagement_cookbook"/>
            <field name="implied_ids" eval="[(4, ref('group_engagement_cookbook_user'))]"/>
        </record>
    </data>
</sumeru>
