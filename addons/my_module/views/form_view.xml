<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_my_module_form" model="my.module" type="form">
            <header>
                <button name="action_confirm" string="Confirm" type="object" class="sum_highlight" />
                <button name="action_done" string="Done" type="object" class="" />
                <button name="action_reset_draft" string="Reset to Draft" type="object" class="" />
                <field name="state" widget="statusbar" />
            </header>
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="Title..." />
                    </h1>
                </div>
                <group>
                    <group string="Identity">
                        <field name="reference" />
                        <field name="external_code" />
                        <field name="serial_number" />
                        <field name="short_code" />
                        <field name="public_id" />
                        <field name="priority" widget="priority" />
                    </group>
                    <group string="Flags">
                        <field name="active" widget="radio" />
                        <field name="verified" />
                        <field name="archived" />
                        <field name="sequence" />
                    </group>
                </group>
                <notebook>
                    <page string="Scalars" name="scalars">
                        <group>
                            <group string="Numbers">
                                <field name="quantity" />
                                <field name="progress_pct" widget="progress" />
                                <field name="rating" />
                                <field name="amount" />
                                <field name="price" />
                                <field name="tax_rate" />
                                <field name="balance" />
                            </group>
                            <group string="Money">
                                <field name="currency_id" widget="selection" />
                                <field name="subtotal" widget="monetary" />
                                <field name="tax_amount" widget="monetary" />
                                <field name="salary" widget="monetary" />
                            </group>
                        </group>
                        <group>
                            <group string="Dates">
                                <field name="date_start" />
                                <field name="datetime_due" />
                                <field name="completed_at" />
                                <field name="opening_time" />
                                <field name="closing_time" />
                                <field name="processing_time" />
                            </group>
                            <group string="Contact">
                                <field name="email" widget="email" />
                                <field name="phone" widget="phone" />
                                <field name="website" widget="url" />
                            </group>
                        </group>
                    </page>
                    <page string="Text and media" name="text_media">
                        <field name="description" />
                        <field name="notes" widget="html" />
                        <field name="avatar" widget="image" />
                        <field name="document" widget="binary" />
                        <field name="settings" />
                        <field name="metadata_json" />
                    </page>
                    <page string="Relations" name="relations">
                        <group>
                            <group string="Company">
                                <field name="company_id" widget="selection" />
                                <field name="company_name" />
                                <field name="user_id" widget="selection" />
                            </group>
                            <group string="Geo">
                                <field name="country_id" widget="selection" />
                                <field name="state_id" widget="selection" />
                                <field name="city_id" widget="selection" />
                            </group>
                        </group>
                        <group string="Hierarchy">
                            <field name="parent_id" widget="selection" />
                        </group>
                        <field name="tag_ids" widget="many2many_tags" />
                        <field name="category_ids" widget="many2many_tags" />
                    </page>
                    <page string="Reference" name="reference">
                        <field name="resource_ref" widget="reference" />
                        <field name="resource_model" />
                        <field name="resource_id" />
                    </page>
                    <page string="Computed" name="computed">
                        <field name="computed_amount" />
                        <field name="stored_line_count" />
                    </page>
                    <page string="Lines" name="lines">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="name" />
                                <field name="quantity" />
                                <field name="unit_price" />
                                <field name="note" />
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <footer>
                <button name="action_confirm" string="Confirm" type="object" class="" />
            </footer>
        </view>
    </data>
</sumeru>
