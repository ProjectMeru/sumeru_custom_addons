<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_my_module_kanban" model="my.module" type="kanban"
            default_group_by="state" records_draggable="1">
            <field name="state" />
            <field name="avatar" widget="image" />
            <field name="name" />
            <field name="reference" />
            <field name="priority" widget="priority" options="mode:stars,stars:5" />
            <field name="subtotal" widget="monetary" />
            <field name="active" widget="boolean_toggle" />
        </view>
    </data>
</sumeru>
