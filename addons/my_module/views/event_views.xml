<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_my_module_event_list" model="my.module.event" type="list">
            <field name="name" />
            <field name="module_id" />
            <field name="user_id" />
            <field name="date_start" />
            <field name="date_stop" />
            <field name="state" />
        </view>
        <view id="view_my_module_event_form" model="my.module.event" type="form">
            <header>
                <field name="state" widget="statusbar" options="clickable:1" />
            </header>
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="Event name..." />
                    </h1>
                </div>
                <group>
                    <group string="Schedule">
                        <field name="date_start" widget="date" />
                        <field name="date_stop" widget="date" />
                        <field name="state" widget="selection" />
                    </group>
                    <group string="Links">
                        <field name="module_id" widget="many2one" />
                        <field name="user_id" widget="many2one" />
                    </group>
                </group>
            </sheet>
        </view>
        <view id="view_my_module_event_search" model="my.module.event" type="search">
            <field name="name" />
            <filter name="draft" string="Draft" domain='[["state","=","draft"]]' />
            <filter name="planned" string="Planned" domain='[["state","=","planned"]]' />
            <filter name="done" string="Done" domain='[["state","=","done"]]' />
            <filter name="group_state" string="Status" group_by="state" />
        </view>
        <view id="view_my_module_event_calendar" model="my.module.event" type="calendar" date_start="date_start" string="Events">
            <field name="name" />
            <field name="date_start" />
            <field name="user_id" />
        </view>
        <view id="view_my_module_event_gantt" model="my.module.event" type="gantt" date_start="date_start" date_stop="date_stop" string="Events">
            <field name="name" />
            <field name="date_start" />
            <field name="date_stop" />
        </view>
    </data>
</sumeru>
