<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_my_module_search" model="my.module" type="search">
            <field name="name" />
            <field name="reference" />
            <filter name="draft" string="Draft" domain='[["state","=","draft"]]' />
            <filter name="confirmed" string="Confirmed" domain='[["state","=","confirmed"]]' />
            <filter name="done" string="Done" domain='[["state","=","done"]]' />
            <filter name="active" string="Active" domain='[["active","=",true]]' />
            <filter name="my" string="My records" domain='[["user_id","=","$uid"]]' />
            <filter name="group_state" string="Status" group_by="state" />
            <filter name="group_priority" string="Priority" group_by="priority" />
        </view>
    </data>
</sumeru>
