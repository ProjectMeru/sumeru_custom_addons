<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_my_module_line_list" model="my.module.line" type="list">
            <field name="module_id" />
            <field name="name" />
            <field name="quantity" />
            <field name="unit_price" />
        </view>
        <view id="view_my_module_line_form" model="my.module.line" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="Line description..." />
                    </h1>
                </div>
                <group>
                    <field name="module_id" widget="many2one" />
                    <field name="quantity" />
                    <field name="unit_price" />
                    <field name="note" widget="text" />
                </group>
            </sheet>
        </view>
    </data>
</sumeru>
